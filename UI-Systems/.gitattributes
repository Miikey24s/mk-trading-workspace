# Existing consumer pins hash exact source bytes, including line endings.
core/tokens/** -text
# Compact source bytes use CRLF, which is part of the pinned source hash.
core/tokens/compact/0.1.0/*.json whitespace=cr-at-eol
core/tokens/compact/0.1.1/*.json whitespace=cr-at-eol
components/** -text
core/contracts/** -text
# The deterministic exporter terminates snapshots with a blank line.
core/tokens/**/ui-system.snapshot.css whitespace=-blank-at-eof
